#!/usr/bin/env python3

"""Clone selected repositories from repo_configs/git_repos.json.

Behavior is intentionally aligned with `g.py clones`:
- pick a repo type via radiolist
- pick repositories via checklist
- clone each selected repository with progress
- run optional hooks after clone
"""

import json
import os
import re
import subprocess
import sys
from pathlib import Path

import dialog
from tqdm import tqdm


def load_repos_info(repo_config_path):
    """Load repositories from JSON config file."""
    with open(repo_config_path, "r", encoding="utf-8") as f:
        return json.load(f)


def get_radiolist(msg, items):
    choice = []
    dial = dialog.Dialog(dialog="dialog")
    for item in items:
        choice.append((item, "", True))
    code, selected = dial.radiolist(msg, choices=choice)
    if code == "cancel":
        return None, None
    return code, selected


def get_checklist(msg, items):
    choice = []
    dial = dialog.Dialog(dialog="dialog")
    for item in items:
        choice.append((item, "", False))
    code, selected = dial.checklist(msg, choices=choice)
    if code == "cancel":
        return None, None
    return code, selected


def clear_screen():
    os.system("printf '\033c'")


def git_clone_with_progress(repo_url, dest_dir):
    # Expand environment variables in URL.
    repo_url = os.path.expandvars(repo_url)

    # Extract repo name from URL to determine clone path.
    repo_name = os.path.splitext(os.path.basename(repo_url.rstrip("/")))[0]
    clone_path = os.path.join(dest_dir, repo_name)

    # Keep exact skip behavior used by g.py.
    if os.path.exists(clone_path) and os.path.isdir(os.path.join(clone_path, ".git")):
        print(f"Repository '{repo_name}' already cloned at '{clone_path}'. Skipping.")
        return

    print(f"Cloning {repo_url}")
    process = subprocess.Popen(
        ["git", "clone", "--progress", repo_url, clone_path],
        stderr=subprocess.PIPE,
        universal_newlines=True,
    )

    percent_re = re.compile(r"(\d+)%")
    pbar = tqdm(total=100, desc="Cloning", unit="%")

    last_percent = 0

    for line in process.stderr:
        match = percent_re.search(line)
        if match:
            percent = int(match.group(1))
            pbar.update(percent - last_percent)
            last_percent = percent

    process.wait()
    pbar.close()

    if process.returncode != 0:
        print("Clone failed !")


def git_hooks(hooks):
    cmd = os.path.expandvars(hooks)
    cmd = cmd.split(" ")

    try:
        process = subprocess.run(
            cmd,
            check=False,
            stdout=subprocess.PIPE,
            universal_newlines=True,
        )
        return process.stdout
    except subprocess.CalledProcessError as e:
        return e


def git_clone_repos(repos_data):
    repo_types = sorted({repo.get("repo_type") for repo in repos_data if "repo_type" in repo})
    code, repo_type = get_radiolist("Select repo type:", repo_types)
    if repo_type is None or code == "cancel":
        clear_screen()
        return

    repos = [
        repo["component"]
        for repo in repos_data
        if repo.get("repo_type") == repo_type and "component" in repo
    ]
    code, repos = get_checklist("Select the repo:", repos)
    if repos is None or code == "cancel":
        clear_screen()
        return

    clear_screen()

    comp_dict = {item["component"]: item for item in repos_data}

    for repo in repos:
        url = comp_dict[repo].get("url")
        if url is None:
            print(f"{repo}: No URL defined, skipping clone.")
            continue

        git_clone_with_progress(url, ".")

        hooks = comp_dict[repo].get("hooks")
        if hooks is None:
            print(f"{repo}: No hooks defined, skipping hooks.")
            continue

        git_hooks(hooks)


def main():
    # Resolve config from script location so no environment variable is needed.
    script_dir = Path(__file__).resolve().parent
    repos_file = script_dir / "repo_configs" / "git_repos.json"

    try:
        repos_data = load_repos_info(repos_file)
    except FileNotFoundError:
        print(f"Config file not found: {repos_file}")
        return 1
    except json.JSONDecodeError as e:
        print(f"Invalid JSON in config file: {repos_file}\n{e}")
        return 1

    git_clone_repos(repos_data)
    return 0


if __name__ == "__main__":
    sys.exit(main())
